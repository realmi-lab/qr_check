# SQLite 로컬 파일. 운영에서는 절대 경로 권장. 비우지 마세요.
SQLITE_PATH=./data/roombot.sqlite3
APP_TIMEZONE=Asia/Seoul
APP_NOW=
WEB_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
# 이미지 전용 고정 HTTPS 주소를 권장. 임시 터널은 선택적으로 활성화.
IMAGE_BASE_URL=
IMAGE_PORT=8001
IMAGE_TUNNEL=false
CLOUDFLARED_BIN=cloudflared
# 운영 전에 충분히 긴 임의 값으로 바꾸세요. 기존 운영 비밀값은 유지하세요.
SECRET_KEY=replace-with-a-long-random-secret
QR_SECRET=replace-with-another-long-random-secret
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ADMIN_SLACK_USER=
SLACK_NOTIFY_CHANNEL=
NOTIFY_OVERRIDE_SLACK_USER=
ROOM_CHANNELS=true
LEAVE_AFTER_CHECKIN=true
DEMO_MODE=false
MORNING_BRIEF_AT=08:30
CHECKIN_ALLOWED_CIDRS=
TRUST_PROXY_HEADERS=false
ICON_SET=unicode
SESSION_DAYS=30

# Optional Korean font file, required on hosts without a detected Korean font.
# Linux: install fonts-noto-cjk, or set an absolute .ttf/.ttc path.
CHART_FONT_PATH=
