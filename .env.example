# SQLite 로컬 파일. 운영에서는 절대 경로 권장. 비우지 마세요.
SQLITE_PATH=./data/roombot.sqlite3
APP_TIMEZONE=Asia/Seoul
APP_NOW=
WEB_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
# 운영 전에 충분히 긴 임의 값으로 바꾸세요. 기존 운영 비밀값은 유지하세요.
SECRET_KEY=replace-with-a-long-random-secret
QR_SECRET=replace-with-another-long-random-secret
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ADMIN_SLACK_USER=
SLACK_NOTIFY_CHANNEL=
NOTIFY_OVERRIDE_SLACK_USER=
ROOM_CHANNELS=true
LEAVE_AFTER_CHECKIN=true
DEMO_MODE=false
MORNING_BRIEF_AT=08:30
CHECKIN_ALLOWED_CIDRS=
TRUST_PROXY_HEADERS=false
ICON_SET=unicode
SESSION_DAYS=30
